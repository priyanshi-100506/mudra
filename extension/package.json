{
  "name": "clio-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode content && node copy-manifest.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "verify:model": "node scripts/verify-model.mjs",
    "eval": "vitest run --config vitest.eval.config.ts",
    "demo": "node ../scripts/demo.mjs",
    "drive": "node scripts/drive-extension.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.30.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.6.1",
    "canvas": "^3.2.3",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
