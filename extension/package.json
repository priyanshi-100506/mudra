{
  "name": "clio-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "rm -f src/**/*.js src/*.js 2>/dev/null; tsc --noEmit && vite build && BUILD_TARGET=content vite build && node copy-manifest.js",
    "test": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.0.260",
    "@types/react": "^18.2.60",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.6.1",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^5.1.4",
    "vitest": "^1.6.1"
  }
}
