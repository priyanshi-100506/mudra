{
  "manifest_version": 3,
  "name": "MUDRA - On-device Perception for Browser Agents",
  "version": "0.1.0",
  "description": "Perception stays on your device. The planner sees references, never values. SIH26171.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*",
    "file://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>",
        "file://*/*"
      ],
      "js": [
        "src/content/index.ts"
      ]
    }
  ],
  "action": {
    "default_popup": "index.html",
    "default_title": "Mudra"
  }
}
