{
  "manifest_version": 3,
  "name": "CLIO - DOM-First Agent v0.1",
  "version": "0.1.0",
  "description": "DOM-First browser agent prototype learning control loop for SIH26171",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/index.ts"]
    }
  ],
  "action": {
    "default_popup": "index.html"
  }
}