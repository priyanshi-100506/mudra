# Which planner answers: gemini | ollama | stub
#
# Never defaults to stub. A stub running by default would serve canned plans
# that look like a working agent from a backend nobody realised was
# misconfigured.
PLANNER=gemini

# Hosted planner. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Local vision-language planner. Start Ollama as:
#   OLLAMA_ORIGINS='chrome-extension://*' ollama serve
# Without that, every request from the extension returns 403 and local
# inference silently never runs.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_S=120

HOST=127.0.0.1
PORT=8000
